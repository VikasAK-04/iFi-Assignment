<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_large"
    app:cardBackgroundColor="@color/onefi_card_bg"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="@dimen/elevation_popup"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- Success Icon -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:text="@string/confirmation_title"
            android:textColor="@color/onefi_text_primary"
            android:textSize="@dimen/text_size_heading"
            android:textStyle="bold" />

        <!-- Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center"
            android:text="@string/confirmation_message"
            android:textColor="@color/onefi_text_secondary"
            android:textSize="@dimen/text_size_body" />

        <!-- Reference ID Tag -->
        <TextView
            android:id="@+id/tvRefId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:background="@drawable/bg_chip_unselected"
            android:paddingStart="@dimen/spacing_normal"
            android:paddingTop="@dimen/spacing_tiny"
            android:paddingEnd="@dimen/spacing_normal"
            android:paddingBottom="@dimen/spacing_tiny"
            android:textColor="@color/onefi_purple_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            tools:text="Application Reference: #1FI-892401" />

        <!-- Dismiss / Return CTA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoneConfirmation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_large"
            android:backgroundTint="@color/onefi_purple_primary"
            android:text="@string/cta_back_to_marketplace"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_radius_pill" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
