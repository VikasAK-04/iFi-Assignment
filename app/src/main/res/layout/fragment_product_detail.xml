<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onefi_bg_page">

    <!-- Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detailHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/onefi_card_bg"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackDetail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDetailTitleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/onefi_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBackDetail"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="iPhone 15 Pro" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Detail Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomCtaContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailHeaderBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <!-- Hero Image Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_image_height"
                app:cardBackgroundColor="@color/onefi_card_bg"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="1dp"
                app:strokeColor="@color/onefi_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="@dimen/spacing_medium"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_product_phone" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Brand & Tags Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailBrand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/onefi_purple_primary"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    tools:text="Apple" />

                <TextView
                    android:id="@+id/tvDetailRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rating_pill"
                    android:drawablePadding="4dp"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/onefi_amber_accent"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_star"
                    tools:text="4.8 (1,420 reviews)" />
            </LinearLayout>

            <!-- Product Title -->
            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/onefi_text_primary"
                android:textSize="@dimen/text_size_heading"
                android:textStyle="bold"
                tools:text="iPhone 15 Pro" />

            <!-- Price & No Cost EMI Tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/onefi_text_primary"
                    android:textSize="@dimen/text_size_hero"
                    android:textStyle="bold"
                    tools:text="₹1,34,900" />

                <TextView
                    android:id="@+id/tvDetailNoCostTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_normal"
                    android:background="@drawable/bg_tag_green"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/spacing_small"
                    android:paddingBottom="4dp"
                    android:text="@string/no_cost_emi_tag"
                    android:textColor="@color/onefi_green_accent"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Short Description -->
            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textColor="@color/onefi_text_secondary"
                android:textSize="@dimen/text_size_body"
                tools:text="Supercharged by the A17 Pro chip, featuring lightweight titanium frame and pro camera system." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:background="@color/onefi_divider" />

            <!-- Section 1: Variant Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_variant"
                android:textColor="@color/onefi_purple_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVariants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_variant_chip" />

            <!-- Section 2: Key Specifications -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/key_features"
                android:textColor="@color/onefi_purple_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKeyFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/onefi_text_primary"
                android:textSize="@dimen/text_size_body"
                tools:text="• A17 Pro Chip\n• Titanium design\n• 48 MP Main Camera" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:background="@color/onefi_divider" />

            <!-- Section 3: EMI Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/emi_options_title"
                android:textColor="@color/onefi_purple_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/emi_options_subtitle"
                android:textColor="@color/onefi_text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEmiPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_emi_plan_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky CTA Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomCtaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/onefi_card_bg"
        android:elevation="@dimen/elevation_popup"
        android:padding="@dimen/spacing_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layoutEmiPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnProceedEmi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvBottomMonthlyEmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onefi_purple_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="₹22,483 / mo" />

            <TextView
                android:id="@+id/tvBottomTotalPayable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onefi_text_secondary"
                android:textSize="@dimen/text_size_caption"
                tools:text="Total: ₹1,34,900" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceedEmi"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:backgroundTint="@color/onefi_purple_primary"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large"
            android:text="@string/cta_proceed_emi"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_radius_pill"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
