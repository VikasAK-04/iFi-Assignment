<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onefi_bg_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="80dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. 1Fi Hero Purple Header Banner -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroHeaderBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_banner_1fi"
            android:paddingStart="@dimen/spacing_large"
            android:paddingTop="36dp"
            android:paddingEnd="@dimen/spacing_large"
            android:paddingBottom="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- NO COST EMIs Tag -->
            <TextView
                android:id="@+id/tvHeroBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_green"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="4dp"
                android:text="✦ NO-COST EMIs"
                android:textColor="@color/onefi_green_accent"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Headline -->
            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Shop today,\nPay later using\nMutual funds."
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeroBadge" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="No credit score required. No interest.\nBacked by your investments."
                android:textColor="#E9D5FF"
                android:textSize="@dimen/text_size_body"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeroTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Segmented Tab Switcher Control -->
        <LinearLayout
            android:id="@+id/layoutTabContainer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginTop="-24dp"
            android:layout_marginEnd="@dimen/spacing_normal"
            android:background="@drawable/bg_segmented_tab_container"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroHeaderBanner">

            <!-- Tab 1: Top Brands -->
            <TextView
                android:id="@+id/tabTopBrands"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Top Brands"
                android:textColor="@color/onefi_purple_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <!-- Tab 2: Nearby Stores -->
            <TextView
                android:id="@+id/tabNearbyStores"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Nearby Stores"
                android:textColor="@color/onefi_text_secondary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <!-- Tab 3: 1Fi Marketplace -->
            <TextView
                android:id="@+id/tabMarketplace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1Fi Marketplace"
                android:textColor="@color/onefi_text_secondary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 3. Search Bar -->
        <FrameLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginTop="@dimen/spacing_normal"
            android:layout_marginEnd="@dimen/spacing_normal"
            android:background="@drawable/bg_search_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTabContainer">

            <EditText
                android:id="@+id/etShopSearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_height"
                android:background="@null"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/spacing_small"
                android:hint="Search online stores..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingEnd="@dimen/spacing_normal"
                android:textColor="@color/onefi_text_primary"
                android:textColorHint="@color/onefi_text_muted"
                android:textSize="@dimen/text_size_body" />
        </FrameLayout>

        <!-- SECTION A: Top Brands Content View -->
        <LinearLayout
            android:id="@+id/viewTopBrands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_normal"
            android:paddingTop="@dimen/spacing_normal"
            android:paddingEnd="@dimen/spacing_normal"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchBarContainer">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Brands"
                android:textColor="@color/onefi_text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <!-- Air India Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/onefi_card_bg"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="1dp"
                app:strokeColor="@color/onefi_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_normal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgeAirIndia"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#E11D48"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="AIR INDIA"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvBrandAirIndia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:text="Air India"
                        android:textColor="@color/onefi_text_primary"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/badgeAirIndia"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:layout_marginTop="2dp"
                        android:text="No-cost EMIs upto 18 months"
                        android:textColor="@color/onefi_text_secondary"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/badgeAirIndia"
                        app:layout_constraintTop_toBottomOf="@id/tvBrandAirIndia" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Apple Premium Reseller Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/onefi_card_bg"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="1dp"
                app:strokeColor="@color/onefi_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_normal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgeApple"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#0F172A"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/white"
                            android:textSize="28sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvBrandApple"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:text="Apple Premium Reseller"
                        android:textColor="@color/onefi_text_primary"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/badgeApple"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:layout_marginTop="2dp"
                        android:text="No-cost EMIs upto 24 months"
                        android:textColor="@color/onefi_text_secondary"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/badgeApple"
                        app:layout_constraintTop_toBottomOf="@id/tvBrandApple" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CaratLane Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/onefi_card_bg"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="1dp"
                app:strokeColor="@color/onefi_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_normal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgeCaratlane"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#6C2BD9"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="CARAT\nLANE"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvBrandCaratlane"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:text="CaratLane"
                        android:textColor="@color/onefi_text_primary"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/badgeCaratlane"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:layout_marginTop="2dp"
                        android:text="No-cost EMIs upto 6 months"
                        android:textColor="@color/onefi_text_secondary"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/badgeCaratlane"
                        app:layout_constraintTop_toBottomOf="@id/tvBrandCaratlane" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- SECTION B: Nearby Stores View -->
        <LinearLayout
            android:id="@+id/viewNearbyStores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_normal"
            android:paddingTop="@dimen/spacing_normal"
            android:paddingEnd="@dimen/spacing_normal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchBarContainer">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby Stores"
                android:textColor="@color/onefi_text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/onefi_card_bg"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="1dp"
                app:strokeColor="@color/onefi_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_normal">

                    <ImageView
                        android:id="@+id/ivNearbyStoreIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_store"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvNearbyStoreTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:text="1Fi Partner Electronics Store"
                        android:textColor="@color/onefi_text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivNearbyStoreIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:layout_marginTop="2dp"
                        android:text="0.5 km • Instant 1Fi QR EMI Approval"
                        android:textColor="@color/onefi_text_secondary"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivNearbyStoreIcon"
                        app:layout_constraintTop_toBottomOf="@id/tvNearbyStoreTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- SECTION C: 1Fi Marketplace Catalog View -->
        <LinearLayout
            android:id="@+id/viewMarketplaceCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchBarContainer">

            <!-- Category Chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvShopCategoryChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingEnd="@dimen/spacing_normal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_category_chip" />

            <!-- Product Count Bar -->
            <TextView
                android:id="@+id/tvShopProductCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                android:layout_marginTop="@dimen/spacing_small"
                android:textColor="@color/onefi_text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="6 products available" />

            <!-- Products List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvShopProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingTop="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_normal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_product_card" />

            <!-- Loading View State -->
            <LinearLayout
                android:id="@+id/layoutShopLoading"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="@color/onefi_purple_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/loading_products"
                    android:textColor="@color/onefi_text_secondary"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

            <!-- Error View State -->
            <LinearLayout
                android:id="@+id/layoutShopError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_error_outline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/error_title"
                    android:textColor="@color/onefi_text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvShopErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/error_message"
                    android:textColor="@color/onefi_text_secondary"
                    android:textSize="@dimen/text_size_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShopRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_normal"
                    android:backgroundTint="@color/onefi_purple_primary"
                    android:text="@string/cta_retry"
                    android:textColor="@color/white"
                    app:cornerRadius="@dimen/corner_radius_pill" />
            </LinearLayout>

            <!-- Empty View State -->
            <LinearLayout
                android:id="@+id/layoutShopEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_box" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/empty_title"
                    android:textColor="@color/onefi_text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/empty_message"
                    android:textColor="@color/onefi_text_secondary"
                    android:textSize="@dimen/text_size_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShopClearSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_normal"
                    android:backgroundTint="@color/onefi_purple_primary"
                    android:text="@string/cta_clear_search"
                    android:textColor="@color/white"
                    app:cornerRadius="@dimen/corner_radius_pill" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
