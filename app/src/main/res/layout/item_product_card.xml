<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardBackgroundColor="@color/onefi_card_bg"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/onefi_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_normal">

        <!-- Product Image Container -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_chip_unselected"
            android:padding="@dimen/spacing_tiny"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_product_phone" />
        </FrameLayout>

        <!-- No Cost EMI Tag -->
        <TextView
            android:id="@+id/tvTagNoCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:background="@drawable/bg_tag_green"
            android:paddingStart="@dimen/spacing_tiny"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/spacing_tiny"
            android:paddingBottom="2dp"
            android:text="@string/no_cost_emi_tag"
            android:textColor="@color/onefi_green_accent"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageContainer"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginTop="4dp"
            android:textColor="@color/onefi_purple_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvRating"
            app:layout_constraintStart_toEndOf="@id/imageContainer"
            app:layout_constraintTop_toBottomOf="@id/tvTagNoCost"
            tools:text="Apple" />

        <!-- Product Name -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/onefi_text_primary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageContainer"
            app:layout_constraintTop_toBottomOf="@id/tvBrand"
            tools:text="iPhone 15 Pro" />

        <!-- Rating Badge -->
        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rating_pill"
            android:drawablePadding="2dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/onefi_amber_accent"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="4.8" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginTop="6dp"
            android:textColor="@color/onefi_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageContainer"
            app:layout_constraintTop_toBottomOf="@id/tvProductName"
            tools:text="₹1,34,900" />

        <!-- Starting Monthly EMI -->
        <TextView
            android:id="@+id/tvStartingEmi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginTop="2dp"
            android:textColor="@color/onefi_purple_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnViewDetails"
            app:layout_constraintStart_toEndOf="@id/imageContainer"
            app:layout_constraintTop_toBottomOf="@id/tvPrice"
            tools:text="Starting at ₹22,483/mo" />

        <!-- View Details CTA -->
        <TextView
            android:id="@+id/btnViewDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_unselected"
            android:paddingStart="@dimen/spacing_small"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="6dp"
            android:text="@string/view_details"
            android:textColor="@color/onefi_purple_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
