<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onefi_bg_page">

    <!-- Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reviewHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/onefi_card_bg"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackReview"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvReviewHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:text="@string/review_order_title"
            android:textColor="@color/onefi_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBackReview"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Review Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomConfirmContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reviewHeaderBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/review_order_subtitle"
                android:textColor="@color/onefi_text_secondary"
                android:textSize="@dimen/text_size_body" />

            <!-- Product Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                app:cardBackgroundColor="@color/onefi_card_bg"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="1dp"
                app:strokeColor="@color/onefi_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_normal">

                    <ImageView
                        android:id="@+id/ivReviewProductImage"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:src="@drawable/ic_product_phone" />

                    <TextView
                        android:id="@+id/tvReviewBrand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:textColor="@color/onefi_purple_primary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivReviewProductImage"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Apple" />

                    <TextView
                        android:id="@+id/tvReviewProductName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:textColor="@color/onefi_text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivReviewProductImage"
                        app:layout_constraintTop_toBottomOf="@id/tvReviewBrand"
                        tools:text="iPhone 15 Pro" />

                    <TextView
                        android:id="@+id/tvReviewSelectedVariant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/onefi_text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivReviewProductImage"
                        app:layout_constraintTop_toBottomOf="@id/tvReviewProductName"
                        tools:text="Variant: 256 GB" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Financial EMI Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                app:cardBackgroundColor="@color/onefi_card_bg"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="1dp"
                app:strokeColor="@color/onefi_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment &amp; EMI Breakdown"
                        android:textColor="@color/onefi_purple_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <!-- Item 1: Base Price -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_product_price"
                            android:textColor="@color/onefi_text_secondary"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/tvReviewBasePrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="@color/onefi_text_primary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"
                            tools:text="₹1,34,900" />
                    </RelativeLayout>

                    <!-- Item 2: EMI Tenure -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_emi_tenure"
                            android:textColor="@color/onefi_text_secondary"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/tvReviewTenure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="@color/onefi_text_primary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"
                            tools:text="6 Months (0% No Cost)" />
                    </RelativeLayout>

                    <!-- Item 3: Processing Fee -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_processing_fee"
                            android:textColor="@color/onefi_text_secondary"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/tvReviewProcessingFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="@color/onefi_green_accent"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"
                            tools:text="FREE" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:background="@color/onefi_divider" />

                    <!-- Item 4: Monthly EMI -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_monthly_emi"
                            android:textColor="@color/onefi_purple_primary"
                            android:textSize="@dimen/text_size_subtitle"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReviewMonthlyEmi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="@color/onefi_purple_primary"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold"
                            tools:text="₹22,483 / month" />
                    </RelativeLayout>

                    <!-- Item 5: Total Amount -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_total_payable"
                            android:textColor="@color/onefi_text_secondary"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/tvReviewTotalPayable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="@color/onefi_text_secondary"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            tools:text="₹1,34,900" />
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trust Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_tiny"
                    android:text="Verified by 1Fi Instant Credit line"
                    android:textColor="@color/onefi_green_accent"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky CTA Container -->
    <FrameLayout
        android:id="@+id/bottomConfirmContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/onefi_card_bg"
        android:elevation="@dimen/elevation_popup"
        android:padding="@dimen/spacing_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPurchase"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:backgroundTint="@color/onefi_purple_primary"
            android:text="@string/cta_confirm_purchase"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_radius_pill" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
